{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "companyAnnouncements": ["Welcome to Dex solution"],
  "permissions": {
    "allow": [
      "Agent",
      "Bash",
      "Edit",
      "ExitPlanMode",
      "Glob",
      "Grep",
      "NotebookEdit",
      "Read",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Write",
      "Monitor",
      "mcp__electron-playwright",
      "mcp__plugin_media-plugin_media-mcp",
      "mcp__plugin_media-plugin_ElevenLabs",
      "mcp__plugin_media-plugin_mermaid",
      "mcp__plugin_media-plugin_drawio",
      "mcp__plugin_media-plugin_media-playwright",
      "mcp__plugin_web-design-plugin_webdesign-playwright",
      "mcp__plugin_demo-video-plugin_demo-playwright",
      "mcp__plugin_demo-video-plugin_demo-elevenlabs"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/)",
      "Bash(rm -r -f /)",
      "Bash(rm -r -f ~)",
      "Bash(rm -r -f /*)",
      "Bash(rm -r -f ~/)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf ~)",
      "Bash(sudo rm -rf /*)",
      "Bash(sudo rm -rf ~/)",
      "Bash(sudo rm -r -f /)",
      "Bash(sudo rm -r -f ~)",
      "Bash(sudo rm -r -f /*)",
      "Bash(sudo rm -r -f ~/)",

      "Read(./.venv/**)",
      "Grep(./.venv/**)",
      "Edit(./.venv/**)",
      "Read(./**/venv/**)",
      "Grep(./**/venv/**)",
      "Read(./**/.venv/**)",
      "Grep(./**/.venv/**)",

      "Read(./node_modules/**)",
      "Grep(./node_modules/**)",
      "Edit(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Grep(./**/node_modules/**)",

      "Read(~/.ssh/**)",
      "Grep(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",

      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./secrets/**)",
      "Read(./.secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./config/secrets.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",

      "Read(./.git/**)",
      "Grep(./.git/**)",
      "Edit(./.git/**)",
      "Read(./.git/worktrees/**)",

      "Read(./build/**)",
      "Grep(./build/**)",
      "Read(./dist/**)",
      "Grep(./dist/**)",
      "Read(./.next/**)",
      "Grep(./.next/**)",
      "Read(./.nuxt/**)",
      "Read(./out/**)",
      "Read(./__pycache__/**)",
      "Read(./**/__pycache__/**)",
      "Read(./.cache/**)",
      "Read(./.parcel-cache/**)",
      "Read(./.turbo/**)",
      "Read(./target/**)",
      "Read(./*.egg-info/**)",

      "Read(./.yarn/cache/**)",
      "Read(./.pnpm-store/**)",
      "Read(./.npm/**)",
      "Read(~/.npm/**)",
      "Read(~/.yarn/**)",
      "Read(~/.pnpm-store/**)",
      "Read(~/.cache/pip/**)",

      "Read(./.idea/**)",
      "Edit(./.idea/**)",
      "Read(./.vscode/**)",
      "Read(./*.swp)",
      "Read(./**/*.swp)",
      "Read(./*.swo)",
      "Read(./**/*.swo)",

      "Read(./.DS_Store)",
      "Read(./**/.DS_Store)",
      "Read(./Thumbs.db)",
      "Read(./**/Thumbs.db)",

      "Read(./docker-data/**)",
      "Read(./.docker/**)",

      "Read(./**/*.log)",
      "Read(./logs/**)",

      "Read(./.terraform/**)",
      "Read(./terraform.tfstate)",
      "Read(./terraform.tfstate.backup)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.backup)",

      "Read(./coverage/**)",
      "Read(./.nyc_output/**)",
      "Read(./htmlcov/**)",

      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.gcloud/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(./**/serviceAccountKey.json)",
      "Read(./**/*credentials*.json)",
      "Read(./.npmrc)",
      "Read(./.pypirc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.gitconfig)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__electron-playwright__browser_navigate",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️ AUTH REQUIRED: Set Authorization header before navigation!' && echo 'Token:' && grep 'CLAUDE_SERVICE_TOKEN=' claude_tokens.md 2>/dev/null | cut -d'=' -f2 | head -1 || echo 'Token file not found - regenerate token first'"
          }
        ]
      },
      {
        "matcher": "mcp__electron-playwright__browser_(navigate|run_code|snapshot)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/playwright-pre-navigate.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__electron-playwright__browser_(navigate|run_code|snapshot)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/playwright-post-navigate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/playwright-cleanup.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "dev-tools-plugin@claude-my-marketplace": true,
    "office-plugin@claude-my-marketplace": true,
    "infra-plugin@claude-my-marketplace": true,
    "media-plugin@claude-my-marketplace": true,
    "design-plugin@claude-my-marketplace": true,
    "web-design-plugin@claude-my-marketplace": true,
    "demo-video-plugin@claude-my-marketplace": true
  }
}
