node_modules
dist
.vite

.playwright-mcp

.DS_Store


# Dex runtime cache — local only, never committed
.dex/state.json
.dex/state.lock
.dex/variant-groups/
.dex/worktrees/

# demo-video-plugin — media is regenerable, the source of truth is storyboard.json
demo/capture/
demo/audio/
demo/out/
demo/studio/node_modules/
demo/timeline.json

# Bytecode cache from the Python hooks in .claude/hooks/
__pycache__/
*.pyc

# Secrets — never committed. Runtime config goes in .env (with a committed
# .env.example carrying only the names); credential values belong in
# ~/.secrets/secrets.enc.yaml, outside every repo. See .claude/rules/12-security.md.
.env
.env.local
.env.*.local
.envrc
*.key
*.pem
*.agekey
keys.txt

# A plaintext credential file is the anti-pattern 12-security.md forbids —
# gitignored is not protected. Listed so an accidental one cannot be staged.
claude_tokens.md
.agent-token
