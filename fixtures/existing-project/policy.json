{
  "permissionMode": "default",
  "deny": [
    {
      "tool": "Bash",
      "pattern": "(^|[;&|]\\s*)git\\s+push\\b",
      "reason": "this project's maintainers push by hand"
    }
  ],
  "frozen": [
    "docs/claim*.md"
  ],
  "preflight": [
    "test -d .specify"
  ],
  "openPullRequest": false
}
